# Copy to .env and adjust. docker compose reads it for substitution and the
# container receives it via env_file.

# Login for https://llm-wiki.vsda.top uses VSDA Deep Agent accounts: users
# sign in with the same username and password. Accounts are created and
# changed in VSDA Deep Agent, never here.
LLM_WIKI_VSDA_API_URL=http://127.0.0.1:8000
LLM_WIKI_VSDA_APP_URL=https://agent.vsda.top/chat
# Set to 0 to disable the login page (not recommended on a shared domain).
LLM_WIKI_WEB_AUTH=1

# noVNC web port on host loopback; the host nginx proxies to it.
LLM_WIKI_WEB_PORT=5800
LLM_WIKI_DISPLAY_WIDTH=1920
LLM_WIKI_DISPLAY_HEIGHT=1080
LLM_WIKI_DARK_MODE=0

# Host directory holding wiki projects (mounted at /wikis).
LLM_WIKI_DATA_DIR=./data/wikis
# Exported knowledge base project (an LLM Wiki project folder with
# .llm-wiki/project.json), mounted at /wikis/$LLM_WIKI_KB_NAME and opened on
# first start. The existing .llm-wiki/lancedb index holds 1536-dim vectors,
# matching text-embedding-3-small.
LLM_WIKI_KB_DIR=/path/to/vsda-knowledge-base
LLM_WIKI_KB_NAME=vsda-knowledge-base
LLM_WIKI_UID=1000
LLM_WIKI_GID=1000

# copilot-api (host 127.0.0.1:4141) as LLM + embedding provider.
# missing = seed only unset settings; force = re-apply on every start; off.
LLM_WIKI_PROVIDER_SEED=missing
LLM_WIKI_LLM_BASE_URL=http://127.0.0.1:4141/v1
LLM_WIKI_LLM_API_KEY=copilot-api
LLM_WIKI_LLM_MODEL=claude-sonnet-5-5
# LLM Wiki context budget, in characters.
LLM_WIKI_LLM_CONTEXT_SIZE=400000
LLM_WIKI_EMBEDDING_URL=http://127.0.0.1:4141/v1/embeddings
LLM_WIKI_EMBEDDING_API_KEY=copilot-api
LLM_WIKI_EMBEDDING_MODEL=text-embedding-3-small
